# Copy to .env and fill in what you need. Never commit .env.

# ── API server ───────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API.
KAIRO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Required for POST /api/execution/paper and /kill-switch. When unset those routes are refused.
KAIRO_API_KEY=
# Local development only: allow the protected routes without a key.
# KAIRO_ALLOW_UNAUTHENTICATED=1
# SQLite execution store (":memory:" for an ephemeral one).
# KAIRO_DB_PATH=data/kairo.db
# Directory with trained checkpoints (registry.json, *.zip, kairo_hmm.joblib) and research results.
# KAIRO_MODELS_DIR=models
# KAIRO_RESULTS_DIR=results

# ── Frontend (build time) ────────────────────────────────────────────────────
# URL of the API as seen from the *browser*.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Alpaca paper trading (optional) ──────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ── DagsHub / MLflow remote tracking (optional) ──────────────────────────────
DAGSHUB_USERNAME=
DAGSHUB_TOKEN=
